# LLM provider: groq | openai | ollama
IMSKOS_PROVIDER=groq
GROQ_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# IMSKOS_MODEL=llama-3.1-8b-instant
# Local model: IMSKOS_PROVIDER=ollama and IMSKOS_MODEL=gemma4:e4b

# Embeddings and optional cross-encoder reranker
IMSKOS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# IMSKOS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval: dense | bm25 | hybrid
IMSKOS_RETRIEVAL_MODE=hybrid
# Routing: none (retrieve first, default) | evidence | titles
IMSKOS_ROUTER=none
IMSKOS_TOP_K=5

# Vector store: local (numpy + BM25 in ./kb_store) or astra (dense only)
IMSKOS_STORE=local
IMSKOS_STORE_DIR=kb_store
# ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
# ASTRA_DB_APPLICATION_TOKEN=AstraCS:...

# Agent behaviour
IMSKOS_GRADE=true
IMSKOS_VERIFY=true
IMSKOS_DEFENSE=true
IMSKOS_WEB_FALLBACK=true
IMSKOS_MAX_REWRITES=2

# REST API: when set, every request needs the header X-API-Key
# IMSKOS_API_KEYS=change-me

# =============================================================================
# IMSKOS Environment Variables
# Intelligent Multi-Source Knowledge Orchestration System
# =============================================================================
# 
# For Hugging Face Spaces deployment:
#   Add these as "Secrets" in your Space Settings
#
# For local development:
#   Copy this file to .env and fill in your values
#
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: DataStax Astra DB (Vector Store)
# Sign up at: https://astra.datastax.com
# 1. Create a Serverless Vector Database
# 2. Get your Application Token from "Generate Token"
# 3. Copy the Database ID from your dashboard
# -----------------------------------------------------------------------------
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here
ASTRA_DB_ID=your-database-id-here

# -----------------------------------------------------------------------------
# REQUIRED: Groq (LLM Provider)
# Sign up at: https://console.groq.com
# Fast inference with llama-3.1-8b-instant
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_api_key_here

# =============================================================================
# OPTIONAL VARIABLES (for extended functionality)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Auth & Storage) - Optional
# Sign up at: https://supabase.com
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# HuggingFace (Fallback Embeddings) - Optional
# Sign up at: https://huggingface.co/settings/tokens
# Note: Local sentence-transformers is used by default
# -----------------------------------------------------------------------------
HUGGINGFACE_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI (Alternative LLM) - Optional
# Sign up at: https://platform.openai.com
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# =============================================================================
# HOTFIX: Mock Mode & Safety Settings
# =============================================================================

# -----------------------------------------------------------------------------
# Mock Mode (set to 'true' when external services are unavailable)
# When enabled, all external integrations use in-memory/no-op implementations
# -----------------------------------------------------------------------------
MOCK_MODE=false

# -----------------------------------------------------------------------------
# Enable/Disable Indexing (emergency kill switch)
# Set to 'false' to completely disable document indexing
# Useful when experiencing crashes or performance issues
# -----------------------------------------------------------------------------
ENABLE_INDEX_BACKGROUND=true

# -----------------------------------------------------------------------------
# Connection Timeouts (in seconds)
# Adjust based on your network/service latency
# -----------------------------------------------------------------------------
ASTRA_CONNECT_TIMEOUT=30

# Backend URL for Streamlit to call FastAPI endpoints
# Default: http://localhost:8000 for local dev
BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# S3-Compatible Storage - Optional
# Alternative to Supabase Storage
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# -----------------------------------------------------------------------------
# Redis / Upstash (Job Queue)
# Sign up at: https://upstash.com
# If missing: MOCK MODE - uses local Redis or in-memory queue
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# JWT Secret for API authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=

# -----------------------------------------------------------------------------
# Monitoring & Notifications (Optional)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
# Sign up at: https://sentry.io
SENTRY_DSN=

# SendGrid API Key for email notifications
# Sign up at: https://sendgrid.com
SENDGRID_API_KEY=

# Slack Webhook URL for alerts
SLACK_WEBHOOK_URL=
